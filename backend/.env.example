PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/digitalni_zubar
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://localhost:3001
NODE_ENV=development
# "off" gasi rate limit na /auth/* (samo za lokalni razvoj i E2E testove); u produkciji ostaviti prazno
AUTH_RATE_LIMIT=
